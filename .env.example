# ---------------------------------------------------------------------------
# AI Travel Planner - environment variables
# Copy this file to .env.local and fill in your own values.
# Never commit .env.local (it's already in .gitignore).
# ---------------------------------------------------------------------------

# MongoDB connection string (MongoDB Atlas or self-hosted).
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>
MONGODB_URI=

# Auth.js secret used to sign/encrypt session tokens.
# Generate one with: npx auth secret
AUTH_SECRET=

# Base URL of this app, used by Auth.js. In production, set this to your
# deployed URL (e.g. https://your-app.vercel.app).
NEXTAUTH_URL=http://localhost:3000

# OpenRouter API key - https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model slug used for itinerary generation, e.g.
# openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-001
OPENROUTER_MODEL=
